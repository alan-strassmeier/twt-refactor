{
  "manifest_version": 3,
  "name": "TWT - Envio de Coletas",
  "version": "1.0.0",
  "description": "Consulta coletas da Brudam e prepara mensagens para envio assistido pelo WhatsApp.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://twt.com.br/*",
    "https://www.twt.com.br/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Enviar coleta pelo WhatsApp",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "coletas@twt.com.br",
      "strict_min_version": "128.0"
    }
  }
}
