<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>Twt.NfseA3Agent</AssemblyName>
    <RootNamespace>Twt.NfseA3Agent</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <None Update="agentsettings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="scripts\Install-Agent.ps1" Link="Install-Agent.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
