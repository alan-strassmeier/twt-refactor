# Flow publicado para coletar nome, documento e grau/relação do recebedor
WHATSAPP_RECEIVER_FLOW_ID=

# Credenciais da área interna /nfe
NFE_PORTAL_USER=twt
NFE_PORTAL_PASSWORD=
NFE_SESSION_SECRET=

# Credenciais da área interna /faturamento
FATURAMENTO_ADMIN_USER=admin
FATURAMENTO_ADMIN_PASSWORD=
FATURAMENTO_SESSION_SECRET=

# Consulta gratuita ao Ambiente Nacional da SEFAZ
SEFAZ_CERTIFICATE_PFX_BASE64=
SEFAZ_CERTIFICATE_PASSWORD=
SEFAZ_ACTOR_CNPJ=97434690000129
SEFAZ_AUTHOR_UF_CODE=43

# API Brudam (tela 669)
BRUDAM_API_USER=
BRUDAM_API_PASSWORD=
BRUDAM_API_URL=https://twt.brudam.com.br/api/v1

# Leitura privada dos DOCCOBs enviados pela Brudam ao Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=twt-brudam-documentos
R2_DOCCOB_PREFIX=brudam/clientes
# Opcional: quantidade máxima de arquivos recentes examinados por cliente (padrão 250)
R2_DOCCOB_SCAN_LIMIT=250

# Emissão de boletos das faturas TWT exclusivamente pelo C6 Bank
# Use sandbox até concluir a homologação; production troca também a carteira 21 pela 15.
C6_ENVIRONMENT=sandbox
C6_CLIENT_ID=
C6_CLIENT_SECRET=
# Conteúdo dos arquivos .crt e .key fornecidos pelo C6, codificado em Base64
C6_MTLS_CERT_BASE64=
C6_MTLS_KEY_BASE64=
# Preencha apenas quando a chave privada for protegida por senha
C6_MTLS_KEY_PASSPHRASE=
C6_PARTNER_SOFTWARE_NAME=TWT Faturamento
C6_PARTNER_SOFTWARE_VERSION=1.0.0

# Recomendado para impedir duplicidades entre execuções serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
