# Flow publicado para coletar nome, documento e grau/relação do recebedor
WHATSAPP_RECEIVER_FLOW_ID=

# Credenciais da área interna /nfe
NFE_PORTAL_USER=twt
NFE_PORTAL_PASSWORD=
NFE_SESSION_SECRET=

# Credenciais da área interna /faturamento
FATURAMENTO_ADMIN_USER=admin
FATURAMENTO_ADMIN_PASSWORD=
FATURAMENTO_SESSION_SECRET=

# Consulta gratuita ao Ambiente Nacional da SEFAZ
SEFAZ_CERTIFICATE_PFX_BASE64=
SEFAZ_CERTIFICATE_PASSWORD=
SEFAZ_ACTOR_CNPJ=97434690000129
SEFAZ_AUTHOR_UF_CODE=43

# API Brudam (tela 669)
BRUDAM_API_USER=
BRUDAM_API_PASSWORD=
BRUDAM_API_URL=https://twt.brudam.com.br/api/v1

# Leitura privada dos DOCCOBs enviados pela Brudam ao Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=twt-brudam-documentos
R2_DOCCOB_PREFIX=brudam/clientes
# Opcional: quantidade máxima de arquivos recentes examinados por cliente (padrão 250)
R2_DOCCOB_SCAN_LIMIT=250

# Emissão de boletos das faturas TWT exclusivamente pelo C6 Bank
# Use sandbox até concluir a homologação; production troca também a carteira 21 pela 15.
C6_ENVIRONMENT=sandbox
C6_CLIENT_ID=
C6_CLIENT_SECRET=
# Conteúdo dos arquivos .crt e .key fornecidos pelo C6, codificado em Base64
C6_MTLS_CERT_BASE64=
C6_MTLS_KEY_BASE64=
# Preencha apenas quando a chave privada for protegida por senha
C6_MTLS_KEY_PASSPHRASE=
C6_PARTNER_SOFTWARE_NAME=TWT Faturamento
C6_PARTNER_SOFTWARE_VERSION=1.0.0

# Emissão de NFS-e Nacional das faturas TWT
# Mantenha em homologation até concluir os testes e a liberação em produção.
NFSE_ENVIRONMENT=homologation
# Use agent para o certificado A3 físico no computador emissor; use a1 para PFX na Vercel.
NFSE_CERT_MODE=agent
# Opcional: sobrescreve o endpoint oficial correspondente ao ambiente.
NFSE_API_BASE_URL=
# Use uma série numérica exclusiva para esta integração, diferente da série do portal manual.
NFSE_DPS_SERIES=
# Último número já utilizado nessa série; a primeira DPS criada será o número seguinte.
NFSE_DPS_INITIAL_NUMBER=0
NFSE_APPLICATION_VERSION=TWT_1.0.0
NFSE_REQUEST_TIMEOUT_MS=30000
NFSE_PROVIDER_PHONE=5133424425
NFSE_PROVIDER_EMAIL=faturamento@twt.com.br
# Obrigatórias apenas com NFSE_CERT_MODE=a1: conteúdo do .pfx/.p12 em Base64 e sua senha.
NFSE_CERT_PFX_BASE64=
NFSE_CERT_PASSWORD=
# Obrigatório com NFSE_CERT_MODE=agent. Use o mesmo valor no computador emissor.
# Gere pelo PowerShell com RandomNumberGenerator.Create().GetBytes(), conforme a documentação.
NFSE_AGENT_TOKEN=
# Tempo máximo concedido ao agente para processar um trabalho (1 a 15 minutos).
NFSE_AGENT_LEASE_MS=300000
# Pasta privada usada para guardar os XMLs autorizados no mesmo bucket R2.
R2_NFSE_PREFIX=nfse
# Recomendado: token R2 separado com Object Read & Write, limitado ao bucket da NFS-e.
# Se estas quatro variáveis ficarem vazias, será usado o token R2_* geral.
R2_NFSE_ACCOUNT_ID=
R2_NFSE_ACCESS_KEY_ID=
R2_NFSE_SECRET_ACCESS_KEY=
R2_NFSE_BUCKET_NAME=twt-brudam-documentos

# Faturas DSL (97.434.690/0001-29) são reservadas exclusivamente ao Itaú.
# As variáveis serão definidas após o Itaú liberar para a DSL o contrato técnico
# da API de Cobrança, credenciais, certificado mTLS e dados de beneficiário.

# Recomendado para impedir duplicidades entre execuções serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
