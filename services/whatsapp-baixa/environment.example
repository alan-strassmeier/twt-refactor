# Copie para um arquivo fora do Git e use-o como env_file no servidor.
NODE_ENV=production
PORT=3000
APP_TIMEZONE=America/Sao_Paulo

# PostgreSQL na rede Docker interna.
PGHOST=twt-postgres
PGPORT=5432
PGDATABASE=twt
PGUSER=whatsapp_app
PGPASSWORD=SUBSTITUA
PGPOOL_MAX=5

# Entrada e segurança do webhook.
WHATSAPP_PUBLIC_PATH=/api/whatsapp
WHATSAPP_VERIFY_TOKEN=SUBSTITUA
WHATSAPP_APP_SECRET=SUBSTITUA
WHATSAPP_STATE_STORE=postgres
WHATSAPP_IMAGE_STORE=filesystem
WHATSAPP_IMAGE_STORAGE_PATH=/data/whatsapp-baixa
WHATSAPP_IMAGE_RETENTION_DAYS=30
WHATSAPP_IMAGE_MIN_FREE_BYTES=1073741824
WHATSAPP_DRY_RUN=true
WHATSAPP_ENFORCE_ALLOWLIST=true
WHATSAPP_ALLOWED_SENDERS=5551999999999
WHATSAPP_ALLOW_ALL_SENDERS=false
WHATSAPP_MAX_WEBHOOK_BYTES=2097152

# Worker durável. Não reduza o lease abaixo de 900 segundos.
WHATSAPP_WORKER_POLL_MS=1000
WHATSAPP_WORKER_MAX_ATTEMPTS=8
WHATSAPP_WORKER_LEASE_SECONDS=1200

# Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=SUBSTITUA
WHATSAPP_PHONE_NUMBER_ID=SUBSTITUA
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_SEND_REPLIES=true
WHATSAPP_EXAMPLE_IMAGE_URL=https://www.twt.com.br/assets/whatsapp/comprovante-exemplo-5b4e9145.jpeg
WHATSAPP_RECEIVER_FLOW_ID=SUBSTITUA
WHATSAPP_DELIVERY_TIME_FLOW_ID=SUBSTITUA

# Brudam.
BRUDAM_API_URL=https://twt.brudam.com.br/api/v1
BRUDAM_API_USER=SUBSTITUA
BRUDAM_API_PASSWORD=SUBSTITUA
